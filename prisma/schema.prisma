generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique

  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int            @id @default(autoincrement())
  categoryId  Int

  name        String
  slug        String         @unique
  description String
  sold        String         @default("0")
  thumbnail   String
  isPopular   Boolean        @default(false)
  isDeal      Boolean        @default(false)
  isBuyerOnly Boolean        @default(false)

  // E-Commerce & B2B Fields
  retailPrice Float          @default(0)
  moq         Int            @default(1)
  weightGram  Int            @default(1000)
  lengthCm    Int            @default(20)
  widthCm     Int            @default(20)
  heightCm    Int            @default(20)
  stock       Int            @default(100)

  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  wishlists      Wishlist[]
  wholesaleTiers WholesaleTier[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  reviews        Review[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupName String  @default("WARNA") // e.g. "READY" or "WARNA"
  name      String  // e.g. "4 SUSUN", "2 SUSUN", "HIJAU OLIVE"
  price     Float   @default(0)
  stock     Int     @default(50)
  image     String?
  sku       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  image     String
  sortOrder Int     @default(0)
}

model WholesaleTier {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int?
  price     Float
  label     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  PACKING
  READY_TO_SHIP
  ALLOCATED
  PICKING_UP
  PICKED_UP
  DROPPING_OFF
  SHIPPED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderType {
  B2C_RETAIL
  B2B_WHOLESALE
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique
  orderType        OrderType   @default(B2C_RETAIL)
  status           OrderStatus @default(PENDING)
  
  // Customer details
  customerName     String
  customerPhone    String
  customerEmail    String?
  companyName      String?
  taxNumber        String?     // NPWP
  shippingAddress  String
  
  // Shipping details (Biteship)
  courierCode      String?
  courierName      String?
  courierService   String?
  shippingCost     Float       @default(0)
  waybillNumber    String?
  
  // Voucher & Financial details
  subtotal         Float
  promoDiscount    Float       @default(0)
  shippingDiscount Float       @default(0)
  adminFee         Float       @default(2500)
  promoCode        String?
  grandTotal       Float
  paymentMethod    String?
  snapToken        String?
  midtransTrxId    String?
  
  userId           Int?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  weightGram  Int
  variantName String?
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  desktopImage String
  mobileImage  String
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum TestimonialType {
  MEMBER
  MARKETPLACE
}

model Testimonial {
  id        Int             @id @default(autoincrement())
  type      TestimonialType @default(MARKETPLACE)
  name      String
  role      String?
  review    String
  avatar    String?
  isActive  Boolean         @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  username       String?    @unique
  email          String     @unique
  phone          String?
  address        String?
  password       String?
  avatar         String?
  hasPasswordSet Boolean    @default(true)
  isVerified     Boolean    @default(false) // New users require WA OTP verification
  otpCode        String?
  otpExpiresAt   DateTime?
  role           String     @default("USER")
  wishlists      Wishlist[]
  orders         Order[]
  reviews        Review[]
  chatRoom       ChatRoom?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ChatRoom {
  id          Int           @id @default(autoincrement())
  userId      Int?          @unique
  guestToken  String?       @unique
  guestName   String?
  unreadAdmin Int           @default(0)
  unreadUser  Int           @default(0)
  lastMessage String?
  lastSender  String?
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderType String   // "USER" or "ADMIN"
  senderName String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum VoucherScope {
  SHOP
  PRODUCT
}

model Voucher {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  scope            VoucherScope @default(SHOP)
  targetProductIds Int[]        @default([])
  discountType     VoucherType  @default(PERCENTAGE)
  discountValue    Float
  minPurchase      Float        @default(0)
  maxDiscount      Float?
  usageLimit       Int?
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  startDate        DateTime?
  endDate          DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     Int?
  name        String
  rating      Int      @default(5)
  review      String
  variantName String?
  avatar      String?
  mediaUrls   String[] @default([])
  sellerReply String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  date        String
  readTime    String   @default("5 min baca")
  author      String   @default("Tim Spesialis TRI J")
  category    String   @default("Tips Perabotan")
  tags        String[] @default([])
  isHighlight Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}